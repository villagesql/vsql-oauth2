call mtr.add_suppression("VEF auth: role .* is not granted; skipping");
#
# Setup. Roles pre-exist; auto_grant = SYNC. alice is DBA-created (never an
# unknown account), and granted app-grp-extra out of band -- a role no
# token below ever claims.
#
INSTALL EXTENSION vsql_oauth2;
CREATE ROLE `app-grp-dba`;
CREATE ROLE `app-grp-analyst`;
CREATE ROLE `app-grp-extra`;
CREATE USER `alice@myco.example` IDENTIFIED WITH vsql_oauth2;
GRANT `app-grp-extra` TO `alice@myco.example`;
SELECT FROM_USER, TO_USER FROM mysql.role_edges WHERE TO_USER = 'alice@myco.example';
FROM_USER	TO_USER
app-grp-extra	alice@myco.example
#
# (1) Login claims [app-grp-dba, app-grp-analyst]. SYNC grants both and,
# case (b), revokes the unclaimed app-grp-extra. Membership becomes exactly
# {app-grp-analyst, app-grp-dba}.
#
CURRENT_USER()
alice@myco.example@%
SELECT FROM_USER, TO_USER FROM mysql.role_edges WHERE TO_USER = 'alice@myco.example';
FROM_USER	TO_USER
app-grp-analyst	alice@myco.example
app-grp-dba	alice@myco.example
#
# (2) Next login claims only [app-grp-analyst]. Case (a): app-grp-dba is no
# longer claimed, so SYNC REVOKES it. Membership becomes {app-grp-analyst}.
#
CURRENT_USER()
alice@myco.example@%
SELECT FROM_USER, TO_USER FROM mysql.role_edges WHERE TO_USER = 'alice@myco.example';
FROM_USER	TO_USER
app-grp-analyst	alice@myco.example
#
# (3) Case (d): re-login with the same [app-grp-analyst] claim is
# idempotent -- nothing to grant or revoke. Membership unchanged.
#
CURRENT_USER()
alice@myco.example@%
SELECT FROM_USER, TO_USER FROM mysql.role_edges WHERE TO_USER = 'alice@myco.example';
FROM_USER	TO_USER
app-grp-analyst	alice@myco.example
#
# (4) Operator pins a DEFAULT role the token never claims. A default role
# is a deliberate operator statement (auto-create sets none), so SYNC must
# NOT revoke it even though it is unclaimed.
#
GRANT `app-grp-extra` TO `alice@myco.example`;
ALTER USER `alice@myco.example` DEFAULT ROLE `app-grp-extra`;
# Login claims only [app-grp-analyst]: app-grp-extra is unclaimed but
# pinned as default, so it survives; membership {app-grp-analyst,
# app-grp-extra}.
CURRENT_USER()
alice@myco.example@%
SELECT FROM_USER, TO_USER FROM mysql.role_edges WHERE TO_USER = 'alice@myco.example';
FROM_USER	TO_USER
app-grp-analyst	alice@myco.example
app-grp-extra	alice@myco.example
# Undo the pin so the next case can revoke freely.
ALTER USER `alice@myco.example` DEFAULT ROLE NONE;
#
# (5) Case (c): a claim that maps to ZERO roles is an authoritative empty
# set. Point roles_filter at a pattern the token's groups cannot match, so
# [app-grp-analyst] filters out -- SYNC then revokes ALL non-default roles.
#
CURRENT_USER()
alice@myco.example@%
SELECT FROM_USER, TO_USER FROM mysql.role_edges WHERE TO_USER = 'alice@myco.example';
FROM_USER	TO_USER
#
# Cleanup.
#
UNINSTALL EXTENSION vsql_oauth2;
DROP USER `alice@myco.example`;
DROP ROLE `app-grp-dba`;
DROP ROLE `app-grp-analyst`;
DROP ROLE `app-grp-extra`;
