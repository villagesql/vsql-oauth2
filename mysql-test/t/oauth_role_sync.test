# oauth_role_sync -- authoritative role sync (auto_grant = SYNC) for vsql_oauth2.
#
# Companion to oauth_existing_user_grant.test (auto_grant = ON, additive). SYNC
# makes the token's claimed roles the account's EXACT granted set on each login:
# grant the ones it lacks AND revoke every other role it holds that the token
# did not claim. This exercises what ON does not:
#   (a) a role the account holds but the token stops claiming is REVOKED across
#       two logins with different claims;
#   (b) a role a DBA granted out of band, never claimed, is also REVOKED (the
#       token issuer is the sole source of truth);
#   (c) a login whose claim maps to ZERO roles revokes ALL of them (true mirror);
#   (d) a same-claim re-login is idempotent (no spurious grant/revoke).
#
# username_claim=email, roles_claim=groups, roles_filter=app-grp-.*. Pre-signed
# RS256 tokens (oauth_fixtures.inc), all for email=alice@myco.example:
#   autogrant_dba_ana  groups=[app-grp-dba, app-grp-analyst]
#   autogrant_ana      groups=[app-grp-analyst]
#   autogrant_dba      groups=[app-grp-dba]

--source include/not_windows.inc
--source oauth_fixtures.inc

call mtr.add_suppression("VEF auth: role .* is not granted; skipping");

--let $pubkey= $autogrant_pubkey

--echo #
--echo # Setup. Roles pre-exist; auto_grant = SYNC. alice is DBA-created (never an
--echo # unknown account), and granted app-grp-extra out of band -- a role no
--echo # token below ever claims.
--echo #
INSTALL EXTENSION vsql_oauth2;
--disable_query_log
eval SET GLOBAL vsql_oauth2.public_key = '$pubkey';
SET GLOBAL vsql_oauth2.issuer = 'https://idp.example';
SET GLOBAL vsql_oauth2.username_claim = 'email';
SET GLOBAL vsql_oauth2.roles_claim = 'groups';
SET GLOBAL vsql_oauth2.roles_filter = 'app-grp-.*';
SET GLOBAL vsql_oauth2.auto_grant = SYNC;
--enable_query_log

CREATE ROLE `app-grp-dba`;
CREATE ROLE `app-grp-analyst`;
CREATE ROLE `app-grp-extra`;
CREATE USER `alice@myco.example` IDENTIFIED WITH vsql_oauth2;
GRANT `app-grp-extra` TO `alice@myco.example`;
--sorted_result
SELECT FROM_USER, TO_USER FROM mysql.role_edges WHERE TO_USER = 'alice@myco.example';

--echo #
--echo # (1) Login claims [app-grp-dba, app-grp-analyst]. SYNC grants both and,
--echo # case (b), revokes the unclaimed app-grp-extra. Membership becomes exactly
--echo # {app-grp-analyst, app-grp-dba}.
--echo #
--exec $MYSQL --enable_cleartext_plugin --user='alice@myco.example' --password=$autogrant_dba_ana -e "SELECT CURRENT_USER()"
--sorted_result
SELECT FROM_USER, TO_USER FROM mysql.role_edges WHERE TO_USER = 'alice@myco.example';

--echo #
--echo # (2) Next login claims only [app-grp-analyst]. Case (a): app-grp-dba is no
--echo # longer claimed, so SYNC REVOKES it. Membership becomes {app-grp-analyst}.
--echo #
--exec $MYSQL --enable_cleartext_plugin --user='alice@myco.example' --password=$autogrant_ana -e "SELECT CURRENT_USER()"
--sorted_result
SELECT FROM_USER, TO_USER FROM mysql.role_edges WHERE TO_USER = 'alice@myco.example';

--echo #
--echo # (3) Case (d): re-login with the same [app-grp-analyst] claim is
--echo # idempotent -- nothing to grant or revoke. Membership unchanged.
--echo #
--exec $MYSQL --enable_cleartext_plugin --user='alice@myco.example' --password=$autogrant_ana -e "SELECT CURRENT_USER()"
--sorted_result
SELECT FROM_USER, TO_USER FROM mysql.role_edges WHERE TO_USER = 'alice@myco.example';

--echo #
--echo # (4) Operator pins a DEFAULT role the token never claims. A default role
--echo # is a deliberate operator statement (auto-create sets none), so SYNC must
--echo # NOT revoke it even though it is unclaimed.
--echo #
GRANT `app-grp-extra` TO `alice@myco.example`;
ALTER USER `alice@myco.example` DEFAULT ROLE `app-grp-extra`;
--echo # Login claims only [app-grp-analyst]: app-grp-extra is unclaimed but
--echo # pinned as default, so it survives; membership {app-grp-analyst,
--echo # app-grp-extra}.
--exec $MYSQL --enable_cleartext_plugin --user='alice@myco.example' --password=$autogrant_ana -e "SELECT CURRENT_USER()"
--sorted_result
SELECT FROM_USER, TO_USER FROM mysql.role_edges WHERE TO_USER = 'alice@myco.example';
--echo # Undo the pin so the next case can revoke freely.
ALTER USER `alice@myco.example` DEFAULT ROLE NONE;

--echo #
--echo # (5) Case (c): a claim that maps to ZERO roles is an authoritative empty
--echo # set. Point roles_filter at a pattern the token's groups cannot match, so
--echo # [app-grp-analyst] filters out -- SYNC then revokes ALL non-default roles.
--echo #
--disable_query_log
SET GLOBAL vsql_oauth2.roles_filter = 'no-such-grp-.*';
--enable_query_log
--exec $MYSQL --enable_cleartext_plugin --user='alice@myco.example' --password=$autogrant_ana -e "SELECT CURRENT_USER()"
--sorted_result
SELECT FROM_USER, TO_USER FROM mysql.role_edges WHERE TO_USER = 'alice@myco.example';

--echo #
--echo # Cleanup.
--echo #
--disable_query_log
SET GLOBAL vsql_oauth2.auto_grant = OFF;
SET GLOBAL vsql_oauth2.username_claim = 'sub';
SET GLOBAL vsql_oauth2.roles_claim = '';
SET GLOBAL vsql_oauth2.roles_filter = '';
--enable_query_log
UNINSTALL EXTENSION vsql_oauth2;
DROP USER `alice@myco.example`;
DROP ROLE `app-grp-dba`;
DROP ROLE `app-grp-analyst`;
DROP ROLE `app-grp-extra`;
